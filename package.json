{
  "name": "deal-harness",
  "version": "0.0.1",
  "description": "Sales agent harness: skills, a local MCP tools server, and markdown deal memory. Writes Gmail drafts only, never sends.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "deal-harness": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "node dist/cli/index.js serve",
    "eval": "vitest run --config evals/vitest.config.ts",
    "lint": "eslint .",
    "reindex": "node dist/cli/index.js reindex"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/drive": "^22.0.0",
    "@googleapis/gmail": "^18.0.0",
    "@googleapis/sheets": "^14.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "better-sqlite3": "^12.11.1",
    "google-auth-library": "10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
